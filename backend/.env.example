NODE_ENV=development
HOST=127.0.0.1
PORT=3333

# Copie a URL de conexão PostgreSQL do Neon ou do Supabase.
# Exemplo com TLS: postgresql://usuario:senha@host.example:5432/banco?sslmode=verify-full
# Para uma cadeia com CA própria, acrescente sslrootcert com o caminho do certificado.
DATABASE_URL=

# Gere um segredo aleatório em um terminal privado.
# node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
JWT_SECRET_BASE64=
JWT_ISSUER=entrenoites-api
JWT_AUDIENCE=entrenoites-mobile
JWT_TTL_SECONDS=3600
CONSENT_VERSION=sono-1

# A chave é necessária somente para gerar cartões de reflexão.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_MS=45000
